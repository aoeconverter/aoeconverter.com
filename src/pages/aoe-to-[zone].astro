---
import Base from '../layouts/Base.astro';
import { ZONES, type Zone } from '../data/zones';
import { AOE_OFFSET_MS, formatOffset, zoneOffset } from '../lib/aoe';
import { formatInZone, hoursMinutes, shiftWallTime, trackInSentence } from '../lib/format';
import { deadlineRows } from '../lib/deadlines';

export function getStaticPaths() {
  return ZONES.map((zone) => ({ params: { zone: zone.slug }, props: { zone } }));
}

const { zone } = Astro.props as { zone: Zone };

// Offsets in mid-January and mid-July of next year cover standard and daylight time in both hemispheres.
const year = new Date().getUTCFullYear() + 1;
const offsets = [...new Set([Date.UTC(year, 0, 15), Date.UTC(year, 6, 15)].map((t) => zoneOffset(t, zone.iana)))].sort(
  (a, b) => a - b,
);
const variants = offsets.map((offset, i) => ({
  offset,
  gap: offset - AOE_OFFSET_MS,
  label:
    offsets.length === 1
      ? `${zone.short} (${formatOffset(offset)})`
      : `${zone.short}, ${i === 0 ? 'standard time' : 'daylight saving time'} (${formatOffset(offset)})`,
}));
const hasDst = variants.length > 1;

const hours = [...Array(24).keys()].map((h) => ({ h, m: 0 })).concat([{ h: 23, m: 59 }]);
const day = (shift: number) => (shift === 1 ? ' next day' : shift === -1 ? ' previous day' : '');
const fmt = (h: number, m: number) => `${String(h).padStart(2, '0')}:${String(m).padStart(2, '0')}`;

const gapText = (v: (typeof variants)[number]) => hoursMinutes(v.gap);
const at2359 = variants.map((v) => ({ ...v, ...shiftWallTime(23, 59, v.gap) }));

const upcoming = (await deadlineRows()).filter((r) => r.epoch > Date.now()).slice(0, 8);

const title = `${zone.query}: convert Anywhere on Earth time to ${zone.name}`;
const description = hasDst
  ? `AoE (UTC−12) is ${gapText(variants[0])} behind ${zone.name} in standard time and ${gapText(variants[1])} behind during daylight saving. 23:59 AoE is ${at2359[0].time}${day(at2359[0].dayShift)} (${at2359[1].time}${day(at2359[1].dayShift)} in summer). Full table and live clock.`
  : `AoE (UTC−12) is ${gapText(variants[0])} behind ${zone.name}. 23:59 AoE is ${at2359[0].time}${day(at2359[0].dayShift)} ${zone.short}. Full conversion table and live clock.`;
---

<Base
  title={title}
  description={description}
  jsonLd={[
    {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'AoE Converter', item: 'https://aoeconverter.com/' },
        { '@type': 'ListItem', position: 2, name: zone.query, item: `https://aoeconverter.com/aoe-to-${zone.slug}/` },
      ],
    },
  ]}
>
  <article class="zone-page" data-iana={zone.iana}>
    <h1>{zone.query}</h1>
    <p class="lede">
      {
        hasDst ? (
          <>
            Anywhere on Earth (AoE, UTC−12) is <strong>{gapText(variants[0])}</strong> behind {zone.name} in standard time,
            and <strong>{gapText(variants[1])}</strong> behind while {zone.places} observe daylight saving time.
          </>
        ) : (
          <>
            Anywhere on Earth (AoE, UTC−12) is <strong>{gapText(variants[0])}</strong> behind {zone.name}, used in{' '}
            {zone.places}.
          </>
        )
      }
    </p>

    <p class="now" data-now aria-live="off">&nbsp;</p>

    <section class="answer" aria-labelledby="deadline-h">
      <h2 id="deadline-h">When is a “23:59 AoE” deadline in {zone.short}?</h2>
      {
        at2359.map((v) => (
          <p class="big">
            <span class="aoe">23:59 AoE</span> = <strong>{v.time}</strong> {day(v.dayShift).trim() || 'same day'}
            {hasDst && <span class="muted"> ({formatOffset(v.offset)})</span>}
          </p>
        ))
      }
      <p class="muted">
        So a paper due “15 May, 23:59 AoE” can still be submitted until {at2359[0].time}
        {day(at2359[0].dayShift)} in {zone.short}{hasDst ? ', adjusted for daylight saving as above' : ''}.
      </p>
    </section>

    <section aria-labelledby="convert-h">
      <h2 id="convert-h">Convert a specific AoE time</h2>
      <form class="field-row mini" data-mini>
        <div><label for="m-date">Date (AoE)</label><input id="m-date" type="date" required /></div>
        <div><label for="m-time">Time (AoE)</label><input id="m-time" type="time" value="23:59" required /></div>
      </form>
      <output class="mini-out" data-mini-out aria-live="polite"></output>
      <p><a href={`/convert/?tz=AoE`}>Compare with more timezones</a></p>
    </section>

    <section aria-labelledby="table-h">
      <h2 id="table-h">AoE to {zone.short} conversion table</h2>
      <div class="table-wrap">
        <table class="conv">
          <thead>
            <tr>
              <th scope="col">AoE (UTC−12)</th>
              {variants.map((v) => <th scope="col">{v.label}</th>)}
            </tr>
          </thead>
          <tbody>
            {
              hours.map(({ h, m }) => (
                <tr class:list={{ key: h === 23 && m === 59 }}>
                  <th scope="row">{fmt(h, m)}</th>
                  {variants.map((v) => {
                    const r = shiftWallTime(h, m, v.gap);
                    return (
                      <td>
                        {r.time}
                        <span class="muted">{day(r.dayShift)}</span>
                      </td>
                    );
                  })}
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </section>

    {
      upcoming.length > 0 && (
        <section aria-labelledby="up-h">
          <h2 id="up-h">Upcoming conference deadlines in {zone.short} time</h2>
          <ul class="upcoming">
            {upcoming.map((r) => (
              <li data-epoch={r.epoch}>
                <a href={`/conferences/${r.slug}/`}>{`${r.name} ${trackInSentence(r.track)}`}</a>{`: ${formatInZone(r.epoch, zone.iana, 'en-GB').replace(/:00$/, '')}`}
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <section aria-labelledby="faq-h" class="faq">
      <h2 id="faq-h">Questions</h2>
      <h3>Is AoE ahead of or behind {zone.short}?</h3>
      <p>
        Behind. AoE is the last timezone on Earth, so it’s always earlier there than in {zone.places}. When a date ends in
        AoE, it has already ended everywhere else.
      </p>
      <h3>Does AoE change with daylight saving time?</h3>
      <p>
        No. AoE is fixed at UTC−12 all year.{' '}
        {
          hasDst
            ? `${zone.name} does change, so the gap is ${gapText(variants[0])} in standard time and ${gapText(variants[1])} during daylight saving.`
            : `${zone.name} doesn’t use daylight saving either, so the gap is always ${gapText(variants[0])}.`
        }
      </p>
      <h3>Why do conferences use AoE?</h3>
      <p>
        It’s the latest timezone, so no author anywhere loses part of the final day. If it’s still the deadline date
        somewhere on Earth, you’re on time. <a href="/about/">More about AoE</a>.
      </p>
    </section>
  </article>
</Base>

<script>
  import { clock } from '../lib/client';
  import { everySecond } from '../lib/timesync';
  import { aoeParts, pad, parseDate, parseTime, todayAoE, ymdString, zonedToEpoch } from '../lib/aoe';
  import { formatInZone } from '../lib/format';

  const page = document.querySelector<HTMLElement>('[data-iana]')!;
  const iana = page.dataset.iana!;
  const nowEl = document.querySelector<HTMLElement>('[data-now]')!;
  const short = new Intl.DateTimeFormat('en-GB', { timeZone: iana, hour: '2-digit', minute: '2-digit', hourCycle: 'h23' });

  everySecond(
    () => clock.now(),
    (t) => {
      const p = aoeParts(t);
      nowEl.textContent = `Right now it’s ${pad(p.hour)}:${pad(p.minute)} AoE, which is ${short.format(t)} in ${iana.replace(/_/g, ' ').split('/').pop()}.`;
      for (const li of document.querySelectorAll<HTMLElement>('.upcoming [data-epoch]')) {
        li.hidden = Number(li.dataset.epoch) <= t;
      }
    },
  );

  const date = document.querySelector<HTMLInputElement>('#m-date')!;
  const time = document.querySelector<HTMLInputElement>('#m-time')!;
  const out = document.querySelector<HTMLOutputElement>('[data-mini-out]')!;
  date.value = ymdString(todayAoE(clock.now()));
  const update = () => {
    const d = parseDate(date.value);
    const tm = parseTime(time.value);
    out.textContent = d && tm ? formatInZone(zonedToEpoch(d, tm, 'AoE'), iana) : 'Enter a date and time.';
  };
  document.querySelector('[data-mini]')!.addEventListener('input', update);
  update();
</script>

<style>
  .zone-page {
    max-width: 820px;
  }
  .lede {
    font-size: 1.25rem;
    line-height: 1.45;
  }
  .now {
    font-weight: 600;
    min-height: 1.5em;
  }
  section {
    margin-top: 40px;
  }
  .answer .big {
    font-size: clamp(1.5rem, 4vw, 2.25rem);
    font-variation-settings: 'wdth' 80;
    margin: 0.2em 0;
  }
  .answer .aoe {
    color: var(--muted);
  }
  .mini {
    max-width: 420px;
  }
  .mini-out {
    display: block;
    font-size: 1.25rem;
    font-weight: 600;
    margin: 12px 0;
    border-left: 4px solid var(--buoy);
    padding-left: 12px;
  }
  .table-wrap {
    overflow-x: auto;
  }
  .conv {
    border-collapse: collapse;
    min-width: 100%;
  }
  .conv th,
  .conv td {
    text-align: left;
    padding: 6px 24px 6px 0;
    border-bottom: 1px solid var(--line);
    white-space: nowrap;
  }
  .conv thead th {
    font-size: 0.9375rem;
  }
  .conv tbody th {
    font-weight: 700;
  }
  .conv tr.key {
    box-shadow: inset 4px 0 0 var(--buoy);
  }
  .conv tr.key th {
    padding-left: 10px;
  }
  .upcoming {
    padding-left: 1.2em;
    line-height: 1.9;
  }
  .faq h3 {
    margin-top: 1.4em;
  }
</style>
