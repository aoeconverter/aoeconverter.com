---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { deadlineEpoch } from '../lib/aoe';
import { deadlinePath } from '../lib/format';
import { addConferenceUrl, fixDeadlineUrl } from '../lib/repo';

const rows = (await getCollection('conferences'))
  .flatMap(({ id, data }) =>
    data.deadlines.map((d) => ({
      slug: id,
      name: data.name,
      field: data.field,
      url: data.url,
      location: data.location,
      track: d.track,
      date: d.date,
      time: d.time,
      epoch: deadlineEpoch(d.date, d.time)!,
    })),
  )
  .sort((a, b) => a.epoch - b.epoch);
const fields = [...new Set(rows.map((r) => r.field))].sort();
---

<Base title="Conference deadlines in AoE, with live countdowns" description="Upcoming academic conference submission deadlines given in Anywhere on Earth (AoE) time, with countdowns and calendar reminders.">
  <h1>Upcoming conference deadlines</h1>
  <p class="muted">
    Deadlines given in AoE, soonest first. Anyone can add a conference; each one is checked against its official call
    for papers before it’s listed. Dates still change, so confirm on the conference site before you plan around one.
  </p>

  <div class="toolbar">
    <div class="filters">
      <label for="field">Field</label>
      <select id="field" data-filter>
        <option value="">All fields</option>
        {fields.map((f) => <option value={f}>{f}</option>)}
      </select>
    </div>
    <a class="btn" href={addConferenceUrl} rel="noopener">Add a conference</a>
  </div>

  <ol class="list" data-list>
    {
      rows.map((r) => (
        <li data-epoch={r.epoch} data-field={r.field}>
          <div class="info">
            <h2>
              <a href={r.url} rel="noopener">{r.name}</a>
            </h2>
            <p>{[r.track, r.field, r.location].filter(Boolean).join(', ')}</p>
          </div>
          <div class="due">
            <span class="left" data-left>
              {r.date}
            </span>
            <span class="muted">
              {r.date} {r.time || '23:59'} AoE
            </span>
          </div>
          <div class="links">
            <a href={deadlinePath({ date: r.date, time: r.time, name: `${r.name} ${r.track.toLowerCase()}` })}>
              Countdown and reminders
            </a>
            <a class="fix" href={fixDeadlineUrl(r.slug)} rel="noopener">
              Report a wrong date
            </a>
          </div>
        </li>
      ))
    }
  </ol>
  <p class="empty" data-empty-field hidden>No upcoming deadlines in this field right now.</p>
  <p class="empty" data-empty-all hidden>
    No upcoming deadlines yet. <a href={addConferenceUrl} rel="noopener">Add the first one</a>; it takes a minute and
    no Git knowledge.
  </p>
</Base>

<script>
  import { clock } from '../lib/client';
  import { everySecond } from '../lib/timesync';
  import { countdownText } from '../lib/format';

  const items = [...document.querySelectorAll<HTMLLIElement>('[data-list] li')];
  const filter = document.querySelector<HTMLSelectElement>('[data-filter]')!;
  const emptyField = document.querySelector<HTMLElement>('[data-empty-field]')!;
  const emptyAll = document.querySelector<HTMLElement>('[data-empty-all]')!;

  function apply(now: number) {
    let shown = 0;
    for (const li of items) {
      const left = Number(li.dataset.epoch) - now;
      const visible = left > 0 && (!filter.value || li.dataset.field === filter.value);
      li.hidden = !visible;
      if (!visible) continue;
      shown++;
      li.querySelector('[data-left]')!.textContent = countdownText(left);
      li.classList.toggle('soon', left < 7 * 86400_000);
    }
    const anyUpcoming = items.some((li) => Number(li.dataset.epoch) > now);
    emptyAll.hidden = anyUpcoming;
    emptyField.hidden = !anyUpcoming || shown > 0;
  }
  filter.addEventListener('change', () => apply(clock.now()));
  everySecond(() => clock.now(), apply);
</script>

<style>
  .toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px;
    margin: 24px 0;
  }
  .filters {
    width: min(320px, 100%);
  }
  .list {
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: 1px solid var(--line);
  }
  .list li {
    display: grid;
    grid-template-columns: 1fr auto auto;
    gap: 8px 32px;
    align-items: center;
    padding: 18px 0;
    border-bottom: 1px solid var(--line);
  }
  .list li[hidden] {
    display: none;
  }
  .info h2 {
    font-size: 1.25rem;
    margin: 0;
  }
  .info h2 a {
    text-decoration: none;
  }
  .info p {
    margin: 2px 0 0;
    color: var(--muted);
  }
  .links {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .fix {
    color: var(--muted);
    font-size: 0.875rem;
  }
  .due {
    display: flex;
    flex-direction: column;
    text-align: right;
  }
  .left {
    font-weight: 800;
    font-variation-settings: 'wdth' 62;
    font-size: 2rem;
    line-height: 1;
  }
  .soon .left {
    box-shadow: inset 0 -0.18em 0 var(--buoy);
  }
  .due .muted {
    font-size: 0.875rem;
  }
  @media (max-width: 720px) {
    .list li {
      grid-template-columns: 1fr;
    }
    .due {
      text-align: left;
    }
  }
</style>
