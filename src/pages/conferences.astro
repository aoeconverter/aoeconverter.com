---
import Base from '../layouts/Base.astro';
import data from '../data/conferences.json';
import { deadlineEpoch } from '../lib/aoe';
import { deadlinePath } from '../lib/format';

interface Conf {
  slug: string;
  name: string;
  track?: string;
  field: string;
  deadline_date: string;
  deadline_time?: string;
  url: string;
  example?: boolean;
}

const confs = (data as Conf[])
  .map((c) => ({ ...c, epoch: deadlineEpoch(c.deadline_date, c.deadline_time)! }))
  .filter((c) => c.epoch !== null)
  .sort((a, b) => a.epoch - b.epoch);
const fields = [...new Set(confs.map((c) => c.field))].sort();
---

<Base title="Conference deadlines in AoE, with live countdowns" description="Upcoming academic conference submission deadlines given in Anywhere on Earth (AoE) time, with countdowns and calendar reminders.">
  <h1>Upcoming conference deadlines</h1>
  <p class="muted">
    Deadlines given in AoE, soonest first. Dates change, so check the conference site before you plan around one.
  </p>

  <div class="filters">
    <label for="field">Field</label>
    <select id="field" data-filter>
      <option value="">All fields</option>
      {fields.map((f) => <option value={f}>{f}</option>)}
    </select>
  </div>

  <ol class="list" data-list>
    {
      confs.map((c) => (
        <li data-epoch={c.epoch} data-field={c.field}>
          <div class="info">
            <h2>
              <a href={c.url} rel="noopener">{c.name}</a>
            </h2>
            <p>
              {c.track && <span>{c.track}, </span>}
              <span>{c.field}</span>
              {c.example && <span class="sample"> Sample entry</span>}
            </p>
          </div>
          <div class="due">
            <span class="left" data-left>
              {c.deadline_date}
            </span>
            <span class="muted">
              {c.deadline_date} {c.deadline_time || '23:59'} AoE
            </span>
          </div>
          <a
            class="go"
            href={deadlinePath({ date: c.deadline_date, time: c.deadline_time, name: `${c.name}${c.track ? ' ' + c.track.toLowerCase() : ''}` })}
          >
            Countdown and reminders
          </a>
        </li>
      ))
    }
  </ol>
  <p class="empty" data-empty hidden>No upcoming deadlines in this field right now.</p>
</Base>

<script>
  import { clock } from '../lib/client';
  import { everySecond } from '../lib/timesync';
  import { countdownText } from '../lib/format';

  const items = [...document.querySelectorAll<HTMLLIElement>('[data-list] li')];
  const filter = document.querySelector<HTMLSelectElement>('[data-filter]')!;
  const empty = document.querySelector<HTMLElement>('[data-empty]')!;

  function apply(now: number) {
    let shown = 0;
    for (const li of items) {
      const left = Number(li.dataset.epoch) - now;
      const visible = left > 0 && (!filter.value || li.dataset.field === filter.value);
      li.hidden = !visible;
      if (!visible) continue;
      shown++;
      li.querySelector('[data-left]')!.textContent = countdownText(left);
      li.classList.toggle('soon', left < 7 * 86400_000);
    }
    empty.hidden = shown > 0;
  }
  filter.addEventListener('change', () => apply(clock.now()));
  everySecond(() => clock.now(), apply);
</script>

<style>
  .filters {
    max-width: 320px;
    margin: 24px 0;
  }
  .list {
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: 1px solid var(--line);
  }
  .list li {
    display: grid;
    grid-template-columns: 1fr auto auto;
    gap: 8px 32px;
    align-items: center;
    padding: 18px 0;
    border-bottom: 1px solid var(--line);
  }
  .list li[hidden] {
    display: none;
  }
  .info h2 {
    font-size: 1.25rem;
    margin: 0;
  }
  .info h2 a {
    text-decoration: none;
  }
  .info p {
    margin: 2px 0 0;
    color: var(--muted);
  }
  .sample {
    font-weight: 700;
    color: var(--signal);
  }
  .due {
    display: flex;
    flex-direction: column;
    text-align: right;
  }
  .left {
    font-weight: 800;
    font-variation-settings: 'wdth' 62;
    font-size: 2rem;
    line-height: 1;
  }
  .soon .left {
    box-shadow: inset 0 -0.18em 0 var(--buoy);
  }
  .due .muted {
    font-size: 0.875rem;
  }
  @media (max-width: 720px) {
    .list li {
      grid-template-columns: 1fr;
    }
    .due {
      text-align: left;
    }
  }
</style>
