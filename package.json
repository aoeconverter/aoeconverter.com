{
  "name": "aoeconverter",
  "private": true,
  "type": "module",
  "scripts": {
    "build:embed": "esbuild src/embed/index.ts --bundle --minify --format=iife --target=es2019 --outfile=public/embed/v1.js",
    "dev": "npm run build:embed && astro dev",
    "build": "npm run build:embed && astro build",
    "preview": "npm run build && wrangler pages dev dist --port 8788",
    "test": "vitest run",
    "deploy": "npm run build && wrangler pages deploy dist"
  },
  "dependencies": {
    "astro": "^5.18.2",
    "workers-og": "^0.0.27"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.86.0"
  }
}
